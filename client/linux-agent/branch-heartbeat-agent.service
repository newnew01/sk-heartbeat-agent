[Unit]
Description=Branch Heartbeat Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/branch-heartbeat-agent/branch-heartbeat-agent.sh
Restart=always
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/branch-heartbeat-agent

[Install]
WantedBy=multi-user.target
